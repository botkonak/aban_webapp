# آبان ترید — نمونه متغیرهای محیطی
# این فایل را به .env تغییر نام دهید و مقادیر واقعی را وارد کنید.

# ---- تلگرام ----
BOT_TOKEN=123456789:replace-with-real-bot-token
BOT_USERNAME=anirufutures_bot
ADMIN_UID=6210410341

# ---- دامنه و وب‌هوک ----
# روی VPS آدرس عمومی HTTPS سرویس را وارد کنید. روی Render به‌صورت خودکار از RENDER_EXTERNAL_URL خوانده می‌شود.
WEBAPP_URL=https://your-domain.com
WEBHOOK_PATH=aniru-futures-hook
# یک رشته تصادفی و ثابت (حداقل ۳۲ کاراکتر)
WEBHOOK_SECRET=replace-with-a-long-random-secret
# کلید امضای نشست‌ها؛ ثابت بماند تا کاربران با هر ری‌استارت خارج نشوند
WEBAPP_SECRET=replace-with-another-long-random-secret
WEBAPP_COOKIE_SECURE=true

# ---- اجرا ----
WEBAPP_HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ---- دیتابیس ----
# SQLite (برای VPS با دیسک دائمی):
DATABASE_URL=sqlite:///data/bot.db
# PostgreSQL (Render / Supabase / Neon):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- اختیاری ----
# WEBAPP_SESSION_DAYS=30
# WEBAPP_SCAN_CONCURRENCY=10
# WEBAPP_CANDLE_LIMIT=320
# SCAN_CONCURRENCY=8
# USE_UVLOOP=true
